        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
    </link>

    <link name="front_left_steering_link">
      <pose relative_to="__model__">0.5258472 0.2949655 0.0015843 0 0 0</pose>
      <gravity>true</gravity><self_collide>false</self_collide>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
    </link>
