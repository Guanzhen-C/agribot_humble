    <plugin name="ackermann_drive" filename="libagribot_ackermann_rpp_drive.so">
      <ros><namespace>/</namespace></ros>
      <cmd_vel_topic>/nav2/cmd_vel</cmd_vel_topic>
      <odom_topic>/odom</odom_topic>
      <joint_state_topic>/joint_states</joint_state_topic>
      <odom_frame>odom</odom_frame><base_frame>base_link</base_frame>
      <wheelbase>0.5265855</wheelbase>
      <front_track_width>0.589931</front_track_width>
      <rear_track_width>0.590517</rear_track_width>
      <wheel_radius>0.1275</wheel_radius>
      <max_steering_angle>0.384</max_steering_angle>
      <max_steering_rate>1.2</max_steering_rate>
      <max_speed>0.30</max_speed>
      <max_accel>0.8</max_accel>
      <min_speed_for_curvature>0.02</min_speed_for_curvature>
      <command_timeout>0.5</command_timeout>
      <publish_rate>30.0</publish_rate>
      <publish_tf>false</publish_tf>
      <wheel_torque>200.0</wheel_torque>
    </plugin>
  </model>
