        <pose>0.1425 0 0.143 0.000572424 -0.009139547 -0.000002616</pose>
        <geometry>
          <mesh><uri>model://agribot_hardware_bringup/meshes/hipnuc_n300pro.glb</uri></mesh>
        </geometry>
      </visual>
