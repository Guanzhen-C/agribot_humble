        <pose>0.480089121 -0.000371330 0.184451502 0.007648487 0.001835661 -3.141585634</pose>
        <geometry>
          <mesh><uri>model://agribot_hardware_bringup/meshes/lslidar_c16_v4.glb</uri></mesh>
        </geometry>
      </visual>
      <visual name="camera_body_visual">
        <pose>0.5535 0 0.154 0 0 0</pose>
        <geometry><box><size>0.044 0.040 0.040</size></box></geometry>
        <material><ambient>0.035 0.035 0.035 1</ambient><diffuse>0.035 0.035 0.035 1</diffuse></material>
      </visual>
      <visual name="camera_lens_visual">
