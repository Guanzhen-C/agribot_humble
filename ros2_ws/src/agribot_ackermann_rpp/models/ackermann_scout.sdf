      <visual name="wheel_visual"><pose>0 0 0 0 0 1.5707963267948966</pose><geometry><mesh><uri>model://agribot_hardware_bringup/meshes/ackermann_rear_left_wheel.glb</uri></mesh></geometry></visual>
