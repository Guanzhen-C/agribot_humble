        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
      </visual>
      <visual name="rtk_master_radome">
        <pose>0.1425 0.2952585 0.76676 0 0 0</pose>
        <geometry><cylinder><radius>0.0225</radius><length>0.036</length></cylinder></geometry>
        <material><ambient>0.88 0.88 0.84 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material>
      </visual>
      <visual name="rtk_master_stem">
        <pose>0.1425 0.2952585 0.69476 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.108</length></cylinder></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
      <visual name="rtk_secondary_radome">
        <pose>0.1425 -0.2952585 0.76676 0 0 0</pose>
        <geometry><cylinder><radius>0.0225</radius><length>0.036</length></cylinder></geometry>
        <material><ambient>0.88 0.88 0.84 1</ambient><diffuse>0.88 0.88 0.84 1</diffuse></material>
      </visual>
      <visual name="rtk_secondary_stem">
