    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <pose relative_to="__model__">0.5258472 0.2949655 0.0015843 0 0 0</pose>
      <parent>base_link</parent><child>front_left_steering_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.384</lower><upper>0.384</upper><effort>200</effort><velocity>1.5</velocity></limit><dynamics><damping>2.0</damping></dynamics></axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <pose relative_to="__model__">0.5273242 -0.2949655 0.0015843 0 0 0</pose>
      <parent>base_link</parent><child>front_right_steering_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.384</lower><upper>0.384</upper><effort>200</effort><velocity>1.5</velocity></limit><dynamics><damping>2.0</damping></dynamics></axis>
