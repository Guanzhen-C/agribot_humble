<sdf version="1.7">
  <model name="agribot_ackermann">
    <allow_auto_disable>false</allow_auto_disable>

    <!-- The model origin is the measured rear-axle center (base_link). -->
    <link name="base_link">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <pose>0.2623915 0 0.0615505 0 0 0</pose>
        <mass>50.0</mass>
        <inertia>
          <ixx>1.914</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.672</iyy><iyz>0</iyz><izz>4.084</izz>
        </inertia>
      </inertial>
      <collision name="vehicle_body_collision">
        <pose>0.2623915 0 0.0615505 0 0 0</pose>
        <geometry><box><size>0.761611 0.631783 0.245800</size></box></geometry>
      </collision>
      <visual name="vehicle_body_visual">
        <pose>0.2794632 0.1918975 -0.7587717 0 0 1.5707963267948966</pose>
        <geometry>
          <mesh><uri>model://agribot_hardware_bringup/meshes/ackermann_vehicle_body.glb</uri></mesh>
        </geometry>
      </visual>
