      <gravity>true</gravity><self_collide>false</self_collide>
      <inertial><mass>3.0</mass><inertia><ixx>0.01223</ixx><iyy>0.02438</iyy><izz>0.01223</izz></inertia></inertial>
      <collision name="wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.1275</radius><length>0.081431</length></cylinder></geometry><surface><contact><ode><kp>1000000000</kp><kd>1</kd><min_depth>0.001</min_depth></ode></contact><friction><ode><mu>1.8</mu><mu2>1.5</mu2><fdir1>1 0 0</fdir1></ode></friction></surface></collision>
