<sdf version="1.7">
  <model name="agribot_ackermann_sensor_reference">
    <allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
      </inertial>

      <!-- Hipnuc N300Pro: measured pose, 100 Hz physical output rate. -->
      <sensor name="n300pro_imu" type="imu">
        <pose>0.1425 0 0.143 0.000572424 -0.009139547 -0.000002616</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0008023</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0008023</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0008023</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01091</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01091</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01091</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="n300pro_imu_controller" filename="libgazebo_ros_imu_sensor.so">
          <ros><namespace>/</namespace><remapping>~/out:=imu/data</remapping></ros>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>

      <!--
        LSLIDAR C16 V4: 16 channels, -16..+14 degrees vertically, 0.18 degree
        horizontal resolution at 10 Hz, 100 m configured operating range.
      -->
      <sensor name="lslidar_c16_points" type="ray">
        <pose>0.48 0 0.233 -0.007648487 -0.001835661 0.000007020</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>2000</samples><resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples><resolution>1</resolution>
              <min_angle>-0.2792526803190927</min_angle><max_angle>0.24434609527920614</max_angle>
            </vertical>
          </scan>
          <range><min>0.3</min><max>100.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="c16_controller" filename="libgazebo_ros_velodyne_laser.so">
          <ros><namespace>/</namespace><remapping>~/out:=lidar/points</remapping></ros>
          <frame_name>lidar_link</frame_name>
          <organize_cloud>false</organize_cloud>
          <min_range>0.3</min_range><max_range>100.0</max_range>
          <gaussian_noise>0.01</gaussian_noise>
        </plugin>
      </sensor>

      <!-- Hikrobot MV-CU013-A0UC, calibrated full-resolution stream at 10 Hz. -->
      <sensor name="hikrobot_right_camera" type="camera">
        <!-- Gazebo cameras look along local +X; ROS output uses the optical frame TF. -->
        <pose>0.5755 0 0.154 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name="right_camera">
          <horizontal_fov>0.9362410911749182</horizontal_fov>
          <image><width>1280</width><height>1024</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>100.0</far></clip>
          <distortion>
            <k1>-0.06420938</k1><k2>0.07455611</k2>
            <p1>-0.00096336</p1><p2>0.00001838</p2><k3>0.0</k3>
            <center>0.50993772734375 0.49129508185546875</center>
          </distortion>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </camera>
        <plugin name="hikrobot_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>image_raw:=camera/rgb/image_raw</remapping>
            <remapping>camera_info:=camera/rgb/camera_info</remapping>
          </ros>
          <camera_name>agribot_right_camera</camera_name>
          <frame_name>right_camera_optical_frame</frame_name>
          <camera_info_url>package://agribot_ackermann_rpp/config/hikrobot_camera_1280.yaml</camera_info_url>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
