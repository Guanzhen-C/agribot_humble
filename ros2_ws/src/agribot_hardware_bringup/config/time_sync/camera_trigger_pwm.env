# RDK X5 LPWM1 channel 0 is routed to CAM1/J14 pin 18. The global channel
# identifier is 4 (LPWM controller 1 * 4 channels + channel 0).
LPWM_DEVICE=/dev/hobot-lpwm1
LPWM_CHIP=pwmchip2
LPWM_CHANNEL=0
LPWM_CHANNEL_ID=4
LPWM_EXPECTED_ALIAS=lpwm1
LPWM_EXPECTED_DRIVER=hobot-lpwm

# RTK PPS is split to physical pin 36 for Linux PPS/chrony and physical pin 33
# for LPWM hardware trigger input TIME_SYNC2 (reported by the LPWM driver as
# SGT1, trigger source 2). Preserve every unrelated bit in the pinmux register.
LPWM_TRIGGER_SOURCE=2
LPWM_TIME_SYNC_PINMUX_REGISTER=0x34180080
LPWM_TIME_SYNC_PINMUX_SHIFT=22
LPWM_TIME_SYNC_PINMUX_WIDTH=2
LPWM_TIME_SYNC_PINMUX_VALUE=2

# Hikrobot Line0 trigger: exactly 10 Hz with a 1 ms active-high pulse. LPWM
# restarts this waveform on every hardware PPS rising edge; the first pulse is
# emitted 10 us after that edge.
LPWM_PERIOD_US=100000
LPWM_OFFSET_US=10
LPWM_DUTY_US=1000
LPWM_THRESHOLD_US=0
LPWM_ADJUST_STEP=0

# The Pin 36 Linux PPS input is also monitored. If PPS disappears, the service
# closes LPWM instead of silently continuing with a free-running trigger.
LPWM_PPS_DEVICE=/dev/pps-rtk
LPWM_PPS_TIMEOUT_SEC=2.5
LPWM_READY_FILE=/run/agribot-camera-trigger/ready

# Disable the retired one-shot-aligned ordinary PWM on physical pin 32.
LPWM_LEGACY_PWM_ENABLE_PATH=/sys/class/pwm/pwmchip0/pwm0/enable
