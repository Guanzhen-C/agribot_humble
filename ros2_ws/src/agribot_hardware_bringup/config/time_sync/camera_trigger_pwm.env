# Active backend. Keep j14_lpwm configured below for later use, but only one
# backend is allowed to run at a time.
CAMERA_TRIGGER_BACKEND=pin32_pwm
CAMERA_TRIGGER_PPS_DEVICE=/dev/pps-rtk
CAMERA_TRIGGER_PPS_TIMEOUT_SEC=2.5
CAMERA_TRIGGER_READY_FILE=/run/agribot-camera-trigger/ready

# Current wiring: RDK X5 physical Pin 32 is PWM6, exposed as pwmchip0 channel 0.
# The daemon starts PWM on the first fresh PPS and then monitors every PPS.
# Pin32 cannot be hardware-retriggered without dropping one frame per second,
# so the 10 Hz waveform remains continuous after initial phase alignment.
PWM_CHIP=pwmchip0
PWM_CHANNEL=0
PWM_EXPECTED_ALIAS=pwm3
PWM_PERIOD_NS=100000000
PWM_DUTY_CYCLE_NS=1000000
PWM_POLARITY=normal
PWM_PPS_MAXIMUM_LATENCY_MS=5.0

# Reserved hardware-locked backend for a future J14 breakout. LPWM1 channel 0
# is routed to CAM1/J14 pin 18. Its global channel identifier is 4.
LPWM_DEVICE=/dev/hobot-lpwm1
LPWM_CHIP=pwmchip2
LPWM_CHANNEL=0
LPWM_CHANNEL_ID=4
LPWM_EXPECTED_ALIAS=lpwm1
LPWM_EXPECTED_DRIVER=hobot-lpwm

# RTK PPS enters physical Pin 33 as TIME_SYNC2. The official LPWM register
# mapping selects TIME_SYNC2 with trigger source 6. Preserve unrelated bits in
# the pinmux register when this backend is enabled.
LPWM_TRIGGER_SOURCE=6
LPWM_TIME_SYNC_PINMUX_REGISTER=0x34180080
LPWM_TIME_SYNC_PINMUX_SHIFT=22
LPWM_TIME_SYNC_PINMUX_WIDTH=2
LPWM_TIME_SYNC_PINMUX_VALUE=2

# J14 Line0 trigger: 10 Hz, 1 ms active-high, first edge 10 us after PPS.
LPWM_PERIOD_US=100000
LPWM_OFFSET_US=10
LPWM_DUTY_US=1000
LPWM_THRESHOLD_US=0
LPWM_ADJUST_STEP=0
