# RDK X5 physical pin 32 is PWM6, exposed as pwmchip0 channel 0.
PWM_CHIP=pwmchip0
PWM_CHANNEL=0
PWM_EXPECTED_ALIAS=pwm3

# Hikrobot Line0 trigger: 10 Hz with a 1 ms active-high pulse.
PWM_PERIOD_NS=100000000
PWM_DUTY_CYCLE_NS=1000000
PWM_POLARITY=normal

# Wait for the RTK PPS edge before enabling the 10 Hz hardware PWM. The PWM
# then produces one camera trigger every 100 ms with a fixed PPS phase.
PWM_PHASE_LOCK_TO_PPS=true
PWM_PPS_DEVICE=/dev/pps-rtk
PWM_PPS_TIMEOUT_SEC=5.0
PWM_PPS_MAXIMUM_LATENCY_MS=5.0
PWM_PPS_LOCK_HELPER=/usr/local/sbin/agribot-camera-trigger-pps-lock
