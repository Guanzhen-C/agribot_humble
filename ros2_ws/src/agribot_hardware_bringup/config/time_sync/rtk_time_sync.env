# RTK evaluation-board 6-pin TTL connector, pin 3 TX to RDK X5 pin 10 RX.
RTK_TIME_SERIAL_DEVICE=/dev/ttyS1
# The receiver reports COM1=9600; one RMC and one ZDA sentence per second fit
# comfortably at this rate.
RTK_TIME_BAUD_RATE=9600
RTK_TIME_CHRONY_SOCKET=/run/chrony/rtk.sock
RTK_TIME_MINIMUM_YEAR=2024
RTK_TIME_RECONNECT_INTERVAL_SEC=1.0
