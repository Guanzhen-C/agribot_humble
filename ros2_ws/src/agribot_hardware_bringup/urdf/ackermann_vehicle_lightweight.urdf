<?xml version="1.0"?>
<robot name="agribot_ackermann_lightweight">
  <!--
    Low-complexity RViz model for software-rendered targets. Joint geometry and
    calibrated sensor centers intentionally match ackermann_vehicle.urdf.
  -->
  <material name="body_blue">
    <color rgba="0.13 0.42 0.68 1"/>
  </material>
  <material name="body_silver">
    <color rgba="0.72 0.75 0.78 1"/>
  </material>
  <material name="dark_metal">
    <color rgba="0.10 0.12 0.14 1"/>
  </material>
  <material name="tire_black">
    <color rgba="0.025 0.025 0.025 1"/>
  </material>
  <material name="sensor_red">
    <color rgba="0.75 0.08 0.06 1"/>
  </material>

  <link name="base_link">
    <visual name="lightweight_lower_chassis">
      <origin xyz="0.263 0 0.085" rpy="0 0 0"/>
      <geometry>
        <box size="0.66 0.48 0.07"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <visual name="lightweight_body">
      <origin xyz="0.255 0 0.165" rpy="0 0 0"/>
      <geometry>
        <box size="0.54 0.42 0.10"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <visual name="lightweight_front_cover">
      <origin xyz="0.555 0 0.145" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.44 0.13"/>
      </geometry>
      <material name="body_silver"/>
    </visual>
    <visual name="lightweight_rear_bumper">
      <origin xyz="-0.075 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.54 0.055"/>
      </geometry>
      <material name="body_silver"/>
    </visual>
    <visual name="lightweight_lidar_plate">
      <origin xyz="0.48 0 0.177" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.18 0.014"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <visual name="lightweight_lidar_support_left">
      <origin xyz="0.48 0.065 0.147" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.06"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <visual name="lightweight_lidar_support_right">
      <origin xyz="0.48 -0.065 0.147" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.06"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <visual name="hipnuc_n300pro">
      <origin xyz="0.1425 0 0.143" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.025 0.015"/>
      </geometry>
      <material name="sensor_red"/>
    </visual>
    <visual name="lslidar_c16_v4">
      <origin xyz="0.48 0 0.233" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.059" length="0.078"/>
      </geometry>
      <material name="body_silver"/>
    </visual>
    <visual name="lightweight_lidar_band">
      <origin xyz="0.48 0 0.233" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.060" length="0.025"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
  </link>

  <link name="front_left_steering_link"/>
  <joint name="front_left_steering_joint" type="revolute">
    <origin xyz="0.5258472 0.2949655 0.0015843" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.384" upper="0.384" effort="200" velocity="1.5"/>
  </joint>

  <link name="front_right_steering_link"/>
  <joint name="front_right_steering_joint" type="revolute">
    <origin xyz="0.5273242 -0.2949655 0.0015843" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.384" upper="0.384" effort="200" velocity="1.5"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.1275" length="0.081"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.1275" length="0.081"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.1275" length="0.081"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="0.0000002 0.2952585 0.0000003" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.1275" length="0.081"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="0.0000002 -0.2952585 0.0000003" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
