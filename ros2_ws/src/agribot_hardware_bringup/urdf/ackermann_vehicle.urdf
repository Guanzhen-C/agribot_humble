<?xml version="1.0"?>
<robot name="agribot_ackermann">
  <link name="base_link">
    <visual name="step_vehicle_body">
      <!-- STEP coordinates are converted here to rear-axle-centered ROS axes. -->
      <origin
        xyz="0.2794632 0.1918975 -0.7587717"
        rpy="0 0 1.5707963267948966"/>
      <geometry>
        <mesh
          filename="package://agribot_hardware_bringup/meshes/ackermann_vehicle_body.glb"/>
      </geometry>
    </visual>
    <visual name="hipnuc_n300pro">
      <!-- N300 Pro measurement center; +X follows the installed forward mark. -->
      <origin
        xyz="0.1425 0 0.143"
        rpy="0.000572424 -0.009139547 -0.000002616"/>
      <geometry>
        <mesh
          filename="package://agribot_hardware_bringup/meshes/hipnuc_n300pro.glb"/>
      </geometry>
    </visual>
    <visual name="lslidar_c16_v4">
      <!--
        The C16 STEP origin is its mounting center. Offset it below the calibrated
        optical center and turn the side cable outlet toward vehicle-left (+Y).
      -->
      <origin
        xyz="0.480089121 -0.000371330 0.184451502"
        rpy="0.007648487 0.001835661 -3.141585634"/>
      <geometry>
        <mesh
          filename="package://agribot_hardware_bringup/meshes/lslidar_c16_v4.glb"/>
      </geometry>
    </visual>
  </link>

  <!--
    The wheel meshes are the four original STEP wheel assemblies, recentered at
    their respective hubs. Front steering follows the same two-joint structure
    as the simulated Ackermann vehicle: steer around +Z, then roll around +Y.
  -->
  <link name="front_left_steering_link"/>
  <joint name="front_left_steering_joint" type="revolute">
    <origin xyz="0.5258472 0.2949655 0.0015843" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.384" upper="0.384" effort="200" velocity="1.5"/>
  </joint>

  <link name="front_right_steering_link"/>
  <joint name="front_right_steering_joint" type="revolute">
    <origin xyz="0.5273242 -0.2949655 0.0015843" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.384" upper="0.384" effort="200" velocity="1.5"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry>
        <mesh filename="package://agribot_hardware_bringup/meshes/ackermann_front_left_wheel.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry>
        <mesh filename="package://agribot_hardware_bringup/meshes/ackermann_front_right_wheel.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry>
        <mesh filename="package://agribot_hardware_bringup/meshes/ackermann_rear_left_wheel.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="0.0000002 0.2952585 0.0000003" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry>
        <mesh filename="package://agribot_hardware_bringup/meshes/ackermann_rear_right_wheel.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="0.0000002 -0.2952585 0.0000003" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
