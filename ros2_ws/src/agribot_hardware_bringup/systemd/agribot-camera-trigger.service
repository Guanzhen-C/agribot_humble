[Unit]
Description=Generate the PPS-aligned Hikrobot Line0 trigger on RDK X5
Documentation=https://developer.d-robotics.cc/x5_sdk_doc/linux_development/driver_develop_guide/28-LPWM_Driver_Debug_Guide.html
After=local-fs.target chrony.service agribot-rtk-time.service
Wants=chrony.service agribot-rtk-time.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/default/agribot-camera-trigger
RuntimeDirectory=agribot-camera-trigger
RuntimeDirectoryMode=0755
ExecStartPre=/usr/local/sbin/agribot-camera-trigger-pwm prepare
ExecStart=/usr/local/sbin/agribot-camera-trigger-run
ExecStopPost=/usr/local/sbin/agribot-camera-trigger-pwm cleanup
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
