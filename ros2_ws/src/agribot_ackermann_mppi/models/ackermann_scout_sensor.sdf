<sdf version='1.7'>
  <model name='ackermann_scout_sensor'>
    <allow_auto_disable>false</allow_auto_disable>

    <link name='base_link'>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>false</kinematic>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.01</iyy>
          <iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <sensor name='imu_sensor' type='imu'>
        <pose>0.19 0 0.149 -3.14159 -1.57079 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <plugin name='imu_controller' filename='libgazebo_ros_imu_sensor.so'>
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>

      <sensor name='vlp16_points' type='ray'>
        <pose>0 0 0.5777 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2792526803190927</min_angle>
              <max_angle>0.24434609527920614</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>25.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.003</stddev>
          </noise>
        </ray>
        <plugin name='gazebo_ros_laser_controller' filename='libgazebo_ros_velodyne_laser.so'>
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=points</remapping>
          </ros>
          <tf_prefix></tf_prefix>
          <frame_name>vlp16</frame_name>
          <organize_cloud>false</organize_cloud>
          <min_range>0.3</min_range>
          <max_range>25.0</max_range>
          <gaussian_noise>0.003</gaussian_noise>
        </plugin>
      </sensor>

      <sensor name='bev_front_camera' type='wideanglecamera'>
        <pose>0.09 0 0.76521 0 0.436332 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name='front'>
          <horizontal_fov>3.141592</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796</cutoff_angle>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name='bev_front_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/bev/cameras</namespace>
          </ros>
          <camera_name>front</camera_name>
          <frame_name>bev_front_camera_optical_frame</frame_name>
        </plugin>
      </sensor>

      <sensor name='bev_left_camera' type='wideanglecamera'>
        <pose>0 0.09 0.76521 0 0.436332 1.570795</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name='left'>
          <horizontal_fov>3.141592</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796</cutoff_angle>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name='bev_left_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/bev/cameras</namespace>
          </ros>
          <camera_name>left</camera_name>
          <frame_name>bev_left_camera_optical_frame</frame_name>
        </plugin>
      </sensor>

      <sensor name='bev_rear_camera' type='wideanglecamera'>
        <pose>-0.09 0 0.76521 0 0.436332 3.14159</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name='rear'>
          <horizontal_fov>3.141592</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796</cutoff_angle>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name='bev_rear_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/bev/cameras</namespace>
          </ros>
          <camera_name>rear</camera_name>
          <frame_name>bev_rear_camera_optical_frame</frame_name>
        </plugin>
      </sensor>

      <sensor name='bev_right_camera' type='wideanglecamera'>
        <pose>0 -0.09 0.76521 0 0.436332 -1.570795</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera name='right'>
          <horizontal_fov>3.141592</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20.0</far>
          </clip>
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796</cutoff_angle>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name='bev_right_camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace>/bev/cameras</namespace>
          </ros>
          <camera_name>right</camera_name>
          <frame_name>bev_right_camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
