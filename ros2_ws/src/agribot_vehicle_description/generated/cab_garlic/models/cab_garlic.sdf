              <max_angle>0.24434609527920614</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="c16_controller" filename="libgazebo_ros_velodyne_laser.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=lidar/points</remapping>
