      <sensor name="n300pro_imu" type="imu">
        <pose>0.95 -0.1 0.692167599522 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0008023</stddev>
              </noise>
