      </sensor>
      <sensor name="lslidar_c16_points" type="ray">
        <pose>2 0 0.752591615379 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>2000</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2792526803190927</min_angle>
              <max_angle>0.24434609527920614</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>100.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="c16_controller" filename="libgazebo_ros_velodyne_laser.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=lidar/points</remapping>
          </ros>
          <frame_name>lidar_link</frame_name>
          <organize_cloud>false</organize_cloud>
          <min_range>0.3</min_range>
          <max_range>100.0</max_range>
          <gaussian_noise>0.01</gaussian_noise>
        </plugin>
      </sensor>
      <sensor name="hikrobot_right_camera" type="camera">
        <pose>2.0253 0 0.871178825989 0 0 0</pose>
