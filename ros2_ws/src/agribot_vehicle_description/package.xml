<?xml version="1.0"?>
<package format="3">
  <name>agribot_vehicle_description</name>
  <version>0.1.0</version>
  <description>Canonical vehicle configurations and generated ROS descriptions for Agribot platforms.</description>

  <maintainer email="cgz@example.com">cgz</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>agribot_ackermann_mppi</exec_depend>
  <exec_depend>agribot_hardware_bringup</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>scout_gazebo</exec_depend>
  <exec_depend>scout_navigation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
